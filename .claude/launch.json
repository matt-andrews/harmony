{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "harmony",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run"],
      "port": 8080
    },
    {
      "name": "harmony-scratch",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set HARMONY_STORAGE=file:target/scratch-data&& set HARMONY_BIND=127.0.0.1:8099&& cargo run"],
      "port": 8099
    },
    {
      "name": "harmony-web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    }
  ]
}
