# Where the data lives. The backend is inferred from the value:
#   file:<dir>       local directory  -> <dir>/harmony.json (+ <dir>/backups/)
#   sas:<url>        Azure Blob container SAS URL -> <container>/harmony.json (+ backups/)
# A bare https:// URL is treated as Azure; any other bare string as a directory.
# In Docker, use file:/data (mounted from ./data by docker-compose.yml).
HARMONY_STORAGE=file:./data

# Address the server binds to (the Docker image defaults to 0.0.0.0:8080)
HARMONY_BIND=127.0.0.1:8080

# Log filter
RUST_LOG=harmony=info,tower_http=info
