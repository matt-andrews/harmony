# Storage backend. One of:
#   sas:https://<account>.blob.core.windows.net/harmony?<sas-token>   (Azure Blob, container-level SAS)
#   file:./data/harmony.json                                          (local file, offline dev / tests)
HARMONY_STORAGE=file:./data/harmony.json

# Address the server binds to (Docker uses 0.0.0.0:8080)
HARMONY_BIND=127.0.0.1:8080

# Log filter
RUST_LOG=harmony=info,tower_http=info
